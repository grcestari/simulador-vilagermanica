    <slider x="10" step="1000.0" y="60" max="45000.0" display="total-population" height="33" min="1000.0" direction="Horizontal" default="42000.0" variable="total-population" units="pessoas" width="190" sizeVersion="0"></slider>
    <slider x="10" step="1.0" y="100" max="20.0" display="population-scale" height="33" min="1.0" direction="Horizontal" default="5.0" variable="population-scale" units=":1" width="190" sizeVersion="0"></slider>
    <slider x="10" step="5.0" y="140" max="60.0" display="pct-intoxicated" height="33" min="0.0" direction="Horizontal" default="25.0" variable="pct-intoxicated" units="%" width="190" sizeVersion="0"></slider>
    <slider x="10" step="1.0" y="180" max="50.0" display="num-staff" height="33" min="0.0" direction="Horizontal" default="10.0" variable="num-staff" width="190" sizeVersion="0"></slider>
    <slider x="10" step="0.05" y="220" max="1.0" display="darkness-factor" height="33" min="0.1" direction="Horizontal" default="0.1" variable="darkness-factor" width="190" sizeVersion="0"></slider>
    <slider x="10" step="1.0" y="260" max="60.0" display="pct-elderly" height="33" min="0.0" direction="Horizontal" default="20.0" variable="pct-elderly" units="%" width="190" sizeVersion="0"></slider>
    <slider x="10" step="1.0" y="300" max="1000.0" display="random-seed-val" height="33" min="0.0" direction="Horizontal" default="0.0" variable="random-seed-val" width="190" sizeVersion="0"></slider>

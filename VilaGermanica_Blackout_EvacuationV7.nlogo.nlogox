    <plot x="1590" autoPlotX="true" yMax="50.0" autoPlotY="true" yAxis="Ped/s" y="0" xMin="0.0" height="190" legend="true" xMax="3600.0" yMin="0.0" xAxis="Time (s)" display="Flow Rate Q(t)" width="510" sizeVersion="0">
      <setup></setup>

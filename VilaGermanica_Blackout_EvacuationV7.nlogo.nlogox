    <switch x="10" y="378" height="33" on="false" variable="block-door-2?" display="block-door-2?" width="95" sizeVersion="0"></switch>
    <switch x="10" y="416" height="33" on="false" variable="block-door-3?" display="block-door-3?" width="95" sizeVersion="0"></switch>
    <switch x="10" y="454" height="33" on="false" variable="block-door-4?" display="block-door-4?" width="95" sizeVersion="0"></switch>
    <switch x="10" y="492" height="33" on="false" variable="block-door-5?" display="block-door-5?" width="95" sizeVersion="0"></switch>
    <switch x="115" y="340" height="33" on="false" variable="block-door-6?" display="block-door-6?" width="95" sizeVersion="0"></switch>
    <switch x="115" y="378" height="33" on="false" variable="block-door-7?" display="block-door-7?" width="95" sizeVersion="0"></switch>
    <switch x="115" y="416" height="33" on="false" variable="block-door-8?" display="block-door-8?" width="95" sizeVersion="0"></switch>
    <switch x="115" y="454" height="33" on="false" variable="block-door-9?" display="block-door-9?" width="95" sizeVersion="0"></switch>
    <switch x="115" y="492" height="33" on="false" variable="block-door-10?" display="block-door-10?" width="95" sizeVersion="0"></switch>
    <monitor x="1562" precision="0" y="454" height="45" fontSize="11" display="Evacuated Pedestrians" width="185" sizeVersion="0">evacuated-count</monitor>
    <switch x="1562" y="894" height="33" on="false" variable="emergency-lights?" display="emergency-lights?" width="185" sizeVersion="0"></switch>
    <monitor x="1562" precision="0" y="839" height="45" fontSize="11" display="Mortos (Esmagamento)" width="185" sizeVersion="0">dead-pedestrians</monitor>
    <monitor x="1562" precision="0" y="784" height="45" fontSize="9" display="Intoxicated Count" width="185" sizeVersion="0">count pedestrians with [profile = "intoxicated"] * population-scale</monitor>
    <monitor x="1562" precision="0" y="729" height="45" fontSize="9" display="Elderly Count" width="185" sizeVersion="0">count pedestrians with [profile = "elderly"] * population-scale</monitor>
    <monitor x="1562" precision="0" y="674" height="45" fontSize="9" display="Sober Count" width="185" sizeVersion="0">count pedestrians with [profile = "sober"] * population-scale</monitor>
